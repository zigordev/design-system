{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Mona Sans Variable",
          "Mona Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono Variable",
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 0.8125, "unit": "rem" } },
      "md": { "$value": { "value": 0.9375, "unit": "rem" } },
      "lg": { "$value": { "value": 1.0625, "unit": "rem" } },
      "xl": { "$value": { "value": 1.25, "unit": "rem" } },
      "2xl": { "$value": { "value": 1.5, "unit": "rem" } },
      "3xl": { "$value": { "value": 1.875, "unit": "rem" } },
      "display-min": { "$value": { "value": 2.25, "unit": "rem" } },
      "display-max": { "$value": { "value": 3.5, "unit": "rem" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "number",
      "$description": "Letter spacing in em, applied as calc(var(--ds-font-tracking-*) * 1em).",
      "tight": { "$value": -0.02 },
      "normal": { "$value": 0 },
      "wide": { "$value": 0.04 }
    },
    "underline": {
      "$type": "dimension",
      "$description": "Link underlines: the gap below the text, and the line's thickness at rest and on hover.",
      "offset": { "$value": { "value": 0.1875, "unit": "rem" } },
      "thickness": { "$value": { "value": 1, "unit": "px" } },
      "thickness-strong": { "$value": { "value": 2, "unit": "px" } }
    }
  }
}
