{
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": { "value": 1.75, "unit": "rem" } },
      "md": { "$value": { "value": 2, "unit": "rem" } },
      "lg": { "$value": { "value": 2.5, "unit": "rem" } }
    },
    "icon": {
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } }
    }
  },
  "space": {
    "control": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.5, "unit": "rem" } },
      "md": { "$value": { "value": 0.625, "unit": "rem" } },
      "lg": { "$value": { "value": 0.875, "unit": "rem" } },
      "gap": { "$value": { "value": 0.375, "unit": "rem" } }
    }
  },
  "font": {
    "size": {
      "control": { "$type": "dimension", "$value": "{font.size.sm}" }
    }
  }
}
