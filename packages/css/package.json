{
  "name": "@zigordev/css",
  "version": "0.2.0",
  "description": "CSS for zigordev apps: the tokens, a small reset, base styles and component styles in cascade layers, bundled into one file",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts && publint --strict",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zigordev/tokens": "workspace:*",
    "@zigordev/tsconfig": "catalog:",
    "lightningcss": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigordev/design-system.git",
    "directory": "packages/css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
