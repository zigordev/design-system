{
  "name": "@zigordev/icons",
  "version": "0.2.0",
  "description": "The curated Lucide icon set for zigordev apps, as React components and an SVG sprite",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-lucide"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-sprite.ts && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./sprite.svg ./package.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@zigordev/tsconfig": "catalog:",
    "lucide-static": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigordev/design-system.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
