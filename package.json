{
  "name": "design-system",
  "version": "0.1.46",
  "private": true,
  "description": "Technology-agnostic token + component library shared across kini, gpool, cv and the trading-bot operator console",
  "type": "module",
  "sideEffects": true,
  "exports": {
    "./components/*": "./components/*",
    "./tokens/*": "./tokens/*",
    "./themes/*": "./themes/*",
    "./styles.css": "./styles.css",
    "./_ds_manifest.json": "./_ds_manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "tokens",
    "themes",
    "styles.css",
    "_ds_manifest.json"
  ],
  "peerDependencies": {
    "react": "^18.3 || ^19"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "test": "vitest run",
    "test:a11y": "playwright test"
  }
}
