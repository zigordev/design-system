{
  "name": "design-system",
  "version": "0.1.46",
  "private": true,
  "description": "Technology-agnostic token + component library shared across kini, gpool, cv and the trading-bot operator console",
  "type": "module",
  "sideEffects": true,
  "exports": {
    "./components/*": "./components/*",
    "./tokens/*": "./tokens/*",
    "./themes/*": "./themes/*",
    "./styles.css": "./styles.css",
    "./_ds_manifest.json": "./_ds_manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "tokens",
    "themes",
    "styles.css",
    "_ds_manifest.json"
  ],
  "peerDependencies": {
    "react": "^18.3 || ^19"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "prepare": "node ./scripts/prepare-husky.mjs",
    "format": "prettier --write \"components/**/*.{jsx,js,ts}\" \"tokens/**/*.css\" \"themes/**/*.css\" \"styles.css\" \"scripts/**/*.mjs\" \".github/**/*.{yml,yaml}\" \"*.md\" \"!CHANGELOG.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "format:check": "prettier --check \"components/**/*.{jsx,js,ts}\" \"tokens/**/*.css\" \"themes/**/*.css\" \"styles.css\" \"scripts/**/*.mjs\" \".github/**/*.{yml,yaml}\" \"*.md\" \"!CHANGELOG.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:secrets:gitleaks": "./scripts/precommit-gitleaks.sh",
    "ci:quality:local": "npm run format:check && npm run manifest:check && npm run test:cov",
    "precommit:checks": "npm run test:secrets:gitleaks && npm run ci:quality:local",
    "test:a11y": "playwright test",
    "audit": "npm audit --audit-level=high",
    "clean": "rm -rf coverage playwright-report test-results node_modules"
  }
}
