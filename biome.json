{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["@zigordev/biome-config/biome"],
  "files": {
    "includes": [
      "!**/CHANGELOG.md",
      "!packages/tokens/src/tokens/generated",
      "!packages/icons/src/generated"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/docs/src/plain-html/page/**"],
      "linter": {
        "rules": { "a11y": { "useAriaPropsForRole": "off", "noRedundantRoles": "off" } }
      }
    }
  ]
}
